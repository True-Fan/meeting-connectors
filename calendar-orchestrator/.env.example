# calendar-orchestrator environment. Copy to .env and fill in. .env is gitignored.
# Every setting takes the ORCH_ prefix; nested ones use "__" as the delimiter.

# ---------------------------------------------------------------------------
# Google credentials. Two mutually exclusive modes — pick one and fill in only
# that block. The service refuses to start if the chosen mode is incomplete,
# which is why an unconfigured container exits rather than idling.
# ---------------------------------------------------------------------------

# --- mode A: service account (the default; right for a Workspace bot account) -
# No browser, no refresh token to babysit. Needs domain-wide delegation so the
# service account can impersonate the bot's mailbox — without DELEGATED_SUBJECT
# the API calls hit the service account's own, nonexistent, calendar.
ORCH_GOOGLE__AUTH_MODE=service_account
# Path INSIDE the container. credentials/ is bind-mounted from
# ./calendar-orchestrator/credentials, so drop the JSON key there.
ORCH_GOOGLE__SERVICE_ACCOUNT_FILE=credentials/service-account.json
ORCH_GOOGLE__DELEGATED_SUBJECT=bot@yourdomain.com

# --- mode B: OAuth (for a plain, non-Workspace Google account) ---------------
# Requires a one-time interactive consent. **Run that on the host, not in the
# container**: scripts/oauth_bootstrap.py opens a browser and waits on a local
# callback. Unlike a Chromium profile the resulting token.json is portable plain
# JSON, so bootstrapping on your laptop and mounting it in works fine.
#
#   cd calendar-orchestrator
#   .venv/bin/python scripts/oauth_bootstrap.py
#
#ORCH_GOOGLE__AUTH_MODE=oauth
#ORCH_GOOGLE__OAUTH_CLIENT_SECRET_FILE=credentials/client_secret.json
#ORCH_GOOGLE__OAUTH_TOKEN_FILE=credentials/token.json

# ---------------------------------------------------------------------------
# Which calendar to watch, and where to send joins.
# ---------------------------------------------------------------------------
ORCH_CALENDAR_ID=primary

# Set by docker-compose.yml to http://serve:8000/sessions. The default below is
# for running this on a laptop alongside the connectors service.
#ORCH_BRIDGE__URL=http://localhost:8000/sessions

# Fallback only — the platform is normally read from the invite's own link.
ORCH_BRIDGE__PLATFORM=google_meet

# ---------------------------------------------------------------------------
# Scheduling. Both state files live under state/, bind-mounted from
# ./calendar-orchestrator/state — they are what stop the orchestrator rejoining
# a meeting it has already handled every time it restarts.
# ---------------------------------------------------------------------------
ORCH_POLL_INTERVAL_S=120
ORCH_LOOKAHEAD_HOURS=24
ORCH_JOIN_LEAD_TIME_S=60
ORCH_STATE_FILE=state/triggered_events.json

# ---------------------------------------------------------------------------
# Gmail invite polling. Off by default: it joins meetings from emailed invites,
# which is a lot of authority to hand a service you are still testing.
# ---------------------------------------------------------------------------
ORCH_GMAIL__ENABLED=false
#ORCH_GMAIL__STATE_FILE=state/processed_invites.json
