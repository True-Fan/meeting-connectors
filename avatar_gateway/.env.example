# avatar_gateway environment. Copy to .env and fill in. .env is gitignored — no secrets here.

# ---------------------------------------------------------------------------
# LiveKit — same project as agent-worker/.env (this gateway and agent-worker
# must join the same LiveKit project to ever end up in the same room).
# ---------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me

# ---------------------------------------------------------------------------
# Initialisation (realtime-product) — how agent-worker actually gets into the
# room now. See init_client.py / devtools/local_session.py in agent-worker.
# ---------------------------------------------------------------------------
INIT_URL=http://localhost:8000
# The demo tenant seeded per initialisation-service-module/docs/REBUILD/PHASE_04_LOCAL_SEED.md
INIT_TENANT_ID=11111111-1111-1111-1111-111111111111
INIT_USERNAME=demo_user
INIT_PASSWORD=password123
# Which platform agent to run. Seeded by worker-handling-service-module/scripts/seed_agents.py
# (1=Gunika, 2=Nidhi, 3=Sanjay, 4=Sara).
AGENT_ID=1

# ---------------------------------------------------------------------------
# This gateway's own WebSocket server — must match meeting-connectors'
# MC_AVATAR__URL. 8300, not 8100: Worker Handling owns 8100 in this
# architecture (the old gateway defaulted to 8100).
# ---------------------------------------------------------------------------
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8300
GATEWAY_PATH=/stream

# ---------------------------------------------------------------------------
# Everything below is unchanged from the old gateway's knobs.
# ---------------------------------------------------------------------------
# LIVEKIT_ROOM=            # set to reuse one fixed room instead of one per session
# GATEWAY_PASSTHROUGH=true # forward the avatar's own fMP4 instead of muxing a placeholder
# GATEWAY_AGENT_AUDIO_RATE=48000
# GATEWAY_VIDEO_WIDTH=320
# GATEWAY_VIDEO_HEIGHT=180
# GATEWAY_VIDEO_FPS=10
# GATEWAY_VIDEO_COLOR=0x202124
# GATEWAY_VIDEO_IMAGE=     # loop a still image instead of a solid color
# GATEWAY_FRAGMENT_MS=100
# GATEWAY_AGENT_JOIN_TIMEOUT_S=30
# GATEWAY_LOG_LEVEL=INFO
