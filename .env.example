# Meeting Connectors — environment template
# Copy to .env and fill in. Nested settings use "__" as the delimiter.

MC_ENV=local
MC_APP_NAME=meeting-connectors

# ----- observability -------------------------------------------------------
MC_OBSERVABILITY__LOG_LEVEL=INFO
MC_OBSERVABILITY__JSON_LOGS=false
MC_OBSERVABILITY__HISTOGRAM_CAPACITY=4096

# ----- zoom (M2 ingest / M5 publish) ---------------------------------------
# General app credentials — used for RTMS webhook + handshake signature.
MC_ZOOM__CLIENT_ID=
MC_ZOOM__CLIENT_SECRET=
MC_ZOOM__WEBHOOK_SECRET_TOKEN=

# Meeting SDK app credentials — a SEPARATE credential path from RTMS (doc 003 §4.2).
MC_ZOOM__SDK_KEY=
MC_ZOOM__SDK_SECRET=

# RTMS media subscription. send_rate 20ms is the protocol floor — see doc 003 §3.2.
MC_ZOOM__RTMS_SEND_RATE_MS=20
MC_ZOOM__RTMS_PER_PARTICIPANT_AUDIO=true

# ----- avatar agent (M3) ---------------------------------------------------
MC_AVATAR__URL=ws://localhost:8100/stream
MC_AVATAR__CONNECT_TIMEOUT_S=10.0
MC_AVATAR__SEND_QUEUE_SIZE=25

# ----- media pipeline (M4) -------------------------------------------------
MC_MEDIA__VIDEO_WIDTH=1280
MC_MEDIA__VIDEO_HEIGHT=720
MC_MEDIA__VIDEO_FPS=25
MC_MEDIA__PUBLISH_SAMPLE_RATE_HZ=32000
MC_MEDIA__INBOUND_QUEUE_SIZE=50
MC_MEDIA__VIDEO_QUEUE_SIZE=3
MC_MEDIA__AUDIO_QUEUE_SIZE=10

# ----- sidecar IPC (M5) ----------------------------------------------------
MC_SIDECAR__UDS_PATH=/run/meeting-connectors/sidecar.sock
MC_SIDECAR__CONNECT_TIMEOUT_S=15.0
MC_SIDECAR__HEARTBEAT_INTERVAL_S=2.0
