# Meeting Connectors — environment template
# Copy to .env and fill in. Nested settings use "__" as the delimiter.

MC_ENV=local
MC_APP_NAME=meeting-connectors

# ----- observability -------------------------------------------------------
MC_OBSERVABILITY__LOG_LEVEL=INFO
MC_OBSERVABILITY__JSON_LOGS=false
MC_OBSERVABILITY__HISTOGRAM_CAPACITY=4096

# ----- zoom (M2 ingest / M5 publish) ---------------------------------------
# General app credentials — used for RTMS webhook + handshake signature.
MC_ZOOM__CLIENT_ID=OFVDe6KKTTytihi0wrjyQ
MC_ZOOM__CLIENT_SECRET=5U6WDfIWh2qSP73NcW1ITp3Zrc3QIh6T
MC_ZOOM__WEBHOOK_SECRET_TOKEN=-hQoQrStTDO0GaQjqXGr2A

# Meeting SDK credentials. Historically a separate credential path from RTMS
# (doc 003 §4.2), but Zoom has since merged Meeting SDK auth into the same General
# App Client ID/Secret (legacy "SDK Key/Secret" migrated to Client ID/Client Secret,
# enforced 2026-06-27) — so these are deliberately the same values as CLIENT_ID/
# CLIENT_SECRET above, not a typo.
MC_ZOOM__SDK_KEY=OFVDe6KKTTytihi0wrjyQ
MC_ZOOM__SDK_SECRET=5U6WDfIWh2qSP73NcW1ITp3Zrc3QIh6T

# RTMS media subscription. send_rate 20ms is the protocol floor — see doc 003 §3.2.
MC_ZOOM__RTMS_SEND_RATE_MS=20
MC_ZOOM__RTMS_PER_PARTICIPANT_AUDIO=true

# ----- avatar agent (M3) ---------------------------------------------------
MC_AVATAR__URL=ws://localhost:8100/stream
MC_AVATAR__CONNECT_TIMEOUT_S=10.0
MC_AVATAR__SEND_QUEUE_SIZE=25

# ----- media pipeline (M4) -------------------------------------------------
MC_MEDIA__VIDEO_WIDTH=1280
MC_MEDIA__VIDEO_HEIGHT=720
MC_MEDIA__VIDEO_FPS=25
MC_MEDIA__PUBLISH_SAMPLE_RATE_HZ=32000
MC_MEDIA__INBOUND_QUEUE_SIZE=50
MC_MEDIA__VIDEO_QUEUE_SIZE=3
MC_MEDIA__AUDIO_QUEUE_SIZE=10

# ----- sidecar IPC (M5) ----------------------------------------------------
MC_SIDECAR__UDS_PATH=/tmp/mc-sidecar/sidecar.sock
MC_SIDECAR__CONNECT_TIMEOUT_S=15.0
MC_SIDECAR__HEARTBEAT_INTERVAL_S=2.0

# ============================================================================
# Microsoft Teams connector — all commented out, so this stays a Zoom-only
# deployment until someone opts in.
#
# The connector is registered ONLY when tenant_id, client_id, client_secret and
# sidecar_host are all present. Leaving them unset means the service carries no
# Teams surface at all, and `{"platform": "teams"}` returns a precise
# "no connector registered" instead of failing inside a join.
#
# Setup: src/connectors/teams/sidecar/dotnet/README.md
# Design: docs/design/005-teams-connector-architecture.md
# ============================================================================

# Azure AD app registration. Needs the APPLICATION permissions
# Calls.JoinGroupCall.All and Calls.AccessMedia.All, admin-consented — without
# the second one the bot joins successfully and no media ever flows.
#MC_TEAMS__TENANT_ID=
#MC_TEAMS__CLIENT_ID=
#MC_TEAMS__CLIENT_SECRET=

# The Windows host running mc-teams-sidecar. Teams' app-hosted media is
# Windows/.NET only, so this is a different machine — not a sibling process on a
# shared volume the way Zoom's C++ sidecar is.
#MC_TEAMS__SIDECAR_HOST=teams-bot.internal
#MC_TEAMS__SIDECAR_PORT=8445
#MC_TEAMS__SIDECAR_READY_TIMEOUT_S=60.0

# This link crosses a host boundary carrying meeting audio and a bearer token,
# so TLS is on by default. Point CA_FILE at the sidecar's issuer; add the client
# cert/key pair for mutual TLS on any shared network.
#MC_TEAMS__SIDECAR_TLS_ENABLED=true
#MC_TEAMS__SIDECAR_CA_FILE=/etc/mc/teams-sidecar-ca.pem
#MC_TEAMS__SIDECAR_CLIENT_CERT_FILE=
#MC_TEAMS__SIDECAR_CLIENT_KEY_FILE=

# Per-participant audio. Teams grants up to four dominant speakers with a source
# id, which is what lets EchoGuard filter by identity rather than relying on the
# speaking gate alone.
#MC_TEAMS__UNMIXED_AUDIO=true

# Teams' own media geometry, deliberately separate from MC_MEDIA__*: the two
# SDKs want different values and neither should have to move for the other.
# Teams negotiates video against an enumerated list — 1280x720@25 (this repo's
# shared default) is NOT one of them, which is why fps defaults to 30 here.
#MC_TEAMS__PUBLISH_SAMPLE_RATE_HZ=16000
#MC_TEAMS__VIDEO_WIDTH=1280
#MC_TEAMS__VIDEO_HEIGHT=720
#MC_TEAMS__VIDEO_FPS=30
#MC_TEAMS__DISPLAY_NAME=AI Avatar

# ============================================================================
# Google Meet connector
#
# Unlike Zoom and Teams there is NO app registration, client id, or secret —
# because Google publishes no server-side way to send media into a conference:
#
#   "All conference media streams are "receive-only". Currently, the Meet Media
#    API does not support sending of media from MediaApiClientInterface into a
#    conference."
#   -- developers.google.com/workspace/meet/media-api/reference/cpp/namespace/meet
#
# So the avatar joins as a real signed-in Chromium, and the "credential" is a
# browser profile on disk. Setup: setup-google-meet.txt
# Design:  docs/design/007-google-meet-connector-architecture.md
# ============================================================================

# The ONLY required value. Everything below has a working default.
# Holds the avatar's Google session; treated as a template, cloned per session.
# Sign it in once:  .venv/bin/python tools/meet_signin.py
# Gitignored via .meet/ — it contains a live session cookie.
MC_GOOGLE_MEET__PROFILE_DIR=.meet/profile

# MUST be true. Headed Chromium crashes its renderer on real Meet ("Aw, Snap!",
# error code 11 = SIGSEGV) on this machine, and it does so with ZERO injection and
# ZERO custom flags — proven by isolation: 6/6 headed trials crashed, 8/8 headless
# trials survived, including our full flag set. That is a Chromium/macOS fault, not
# ours. Headless carries media correctly and is verified against real Meet.
MC_GOOGLE_MEET__HEADLESS=true

# Only used if Meet asks for a name, which means the profile lost its Google
# session. A signed-in profile joins under its own account name.
MC_GOOGLE_MEET__DISPLAY_NAME=AI Avatar

# The synthetic camera's geometry. Separate from MC_MEDIA__* because each
# platform's runtime wants its own. Capped at 1080p: every frame crosses the
# page bridge as raw I420, and Meet downscales it anyway.
MC_GOOGLE_MEET__VIDEO_WIDTH=1280
MC_GOOGLE_MEET__VIDEO_HEIGHT=720
MC_GOOGLE_MEET__VIDEO_FPS=25

# Synthetic microphone rate. 48000 is Web Audio's native rate on desktop
# Chromium, so the track needs no resampling stage. Only 16000/24000/48000 are
# accepted — anything else Web Audio would resample *silently*, giving a pitch
# artefact with no error to trace.
MC_GOOGLE_MEET__PUBLISH_SAMPLE_RATE_HZ=48000

# Getting in. LOBBY is deliberately far longer than JOIN: "Asking to join" means
# a human has to notice a notification and click Admit, which is not a failure.
MC_GOOGLE_MEET__JOIN_TIMEOUT_S=120.0
MC_GOOGLE_MEET__LOBBY_TIMEOUT_S=300.0

# Recovery. Lower than the other connectors' 10 because a rejoin here relaunches
# a whole browser and may sit in a lobby again.
MC_GOOGLE_MEET__REJOIN_MAX_ATTEMPTS=5

# Catches the one failure every other health check reports as healthy: the
# browser alive and connected while conference audio has quietly stopped.
MC_GOOGLE_MEET__WATCHDOG_INTERVAL_S=5.0

# The loopback WebSocket the page connects back on. 0 = let the OS choose, which
# is what lets two concurrent sessions coexist.
MC_GOOGLE_MEET__BRIDGE_HOST=127.0.0.1
MC_GOOGLE_MEET__BRIDGE_PORT=0
MC_GOOGLE_MEET__BRIDGE_READY_TIMEOUT_S=60.0

# Extra Chromium flags, appended last so they override the built-ins. JSON list.
# Add --no-sandbox only where the container cannot be given SYS_ADMIN.
#MC_GOOGLE_MEET__EXTRA_BROWSER_ARGS=["--no-sandbox","--disable-setuid-sandbox"]

# Scripted sign-in. NOT recommended: it only bootstraps an empty profile, only
# works on an account with no 2FA, and repeatedly scripting Google's sign-in is
# what gets an automated account restricted. Use tools/meet_signin.py instead.
MC_GOOGLE_MEET__GOOGLE_EMAIL=jadumeetboot@gmail.com
MC_GOOGLE_MEET__GOOGLE_PASSWORD=devch@1234

# ----- Google Meet: browser-side diagnostics --------------------------------
# Both default to off. They exist because a renderer SIGSEGV on real Meet had to be
# isolated to a single injected stage, and they are what made that possible.

# Restrict which bridge.js bootstrap stages install. Empty/absent = all.
# Stages: devices, rtc, observers, heartbeat, socket, then capture, playout, canvas.
# Every stage reports begin/ok/threw, so the last one to complete is always in the log.
# Bisect a crash by walking the list:
#MC_GOOGLE_MEET__INJECT_STAGES=["devices"]
#MC_GOOGLE_MEET__INJECT_STAGES=["devices","rtc"]
#MC_GOOGLE_MEET__INJECT_STAGES=["devices","rtc","observers"]

# The all-or-nothing switch: launch and join, inject nothing. A session with this set
# CANNOT carry media and fails immediately with a message saying so — rather than
# waiting out bridge_ready_timeout_s and then burning the rejoin budget relaunching.
# Prefer INJECT_STAGES for bisecting; this proves whether injection is involved at all.
#MC_GOOGLE_MEET__DISABLE_INJECTION=true
