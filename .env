# Meeting Connectors — environment template
# Copy to .env and fill in. Nested settings use "__" as the delimiter.

MC_ENV=local
MC_APP_NAME=meeting-connectors

# ----- observability -------------------------------------------------------
MC_OBSERVABILITY__LOG_LEVEL=INFO
MC_OBSERVABILITY__JSON_LOGS=false
MC_OBSERVABILITY__HISTOGRAM_CAPACITY=4096

# ----- zoom (M2 ingest / M5 publish) ---------------------------------------
# General app credentials — used for RTMS webhook + handshake signature.
MC_ZOOM__CLIENT_ID=OFVDe6KKTTytihi0wrjyQ
MC_ZOOM__CLIENT_SECRET=5U6WDfIWh2qSP73NcW1ITp3Zrc3QIh6T
MC_ZOOM__WEBHOOK_SECRET_TOKEN=-hQoQrStTDO0GaQjqXGr2A

# Meeting SDK credentials. Historically a separate credential path from RTMS
# (doc 003 §4.2), but Zoom has since merged Meeting SDK auth into the same General
# App Client ID/Secret (legacy "SDK Key/Secret" migrated to Client ID/Client Secret,
# enforced 2026-06-27) — so these are deliberately the same values as CLIENT_ID/
# CLIENT_SECRET above, not a typo.
MC_ZOOM__SDK_KEY=OFVDe6KKTTytihi0wrjyQ
MC_ZOOM__SDK_SECRET=5U6WDfIWh2qSP73NcW1ITp3Zrc3QIh6T

# RTMS media subscription. send_rate 20ms is the protocol floor — see doc 003 §3.2.
# NOTE: PER_PARTICIPANT_AUDIO here is the SDK connector's. zoom_web has its own
# (MC_ZOOM_WEB__PER_PARTICIPANT_AUDIO) and deliberately defaults it the other way.
MC_ZOOM__RTMS_SEND_RATE_MS=20
MC_ZOOM__RTMS_PER_PARTICIPANT_AUDIO=true

# Server-to-Server OAuth app — used only to CALL Zoom's REST API and start RTMS on
# demand for a meeting (POST /live_stream/rtms). Separate credentials from the
# General App above: that one signs the handshake, this one authenticates the call.
# Without these the bridge never asks Zoom to start RTMS, and ingest waits on a
# webhook that only an account auto-start rule or a manual trigger will produce.
MC_ZOOM__ACCOUNT_ID=ODeUs4JlQ3u_0EIQ3Letpg
MC_ZOOM__S2S_CLIENT_ID=WnzT5cUOSbCmzPYKGvGBIQ
MC_ZOOM__S2S_CLIENT_SECRET=nqvTABunuFDrCivd4g3FQhi24fZTYQBa
#MC_ZOOM_WEB__INGEST_MODE=browser (now the default). RTMS is preserved as rtms.
MC_ZOOM_WEB__INGEST_MODE=browser
# The name the avatar joins under when POST /sessions does not specify one — and
# therefore THE NAME SELF-DETECTION MATCHES ON. See the zoom_web block below.
MC_ZOOM__DISPLAY_NAME=AI Avatar
MC_ZOOM_WEB__CAPTIONS_AUTO_ENABLE=true
# ----- avatar agent (M3) ---------------------------------------------------
MC_AVATAR__URL=ws://localhost:8100/stream
MC_AVATAR__CONNECT_TIMEOUT_S=10.0
MC_AVATAR__SEND_QUEUE_SIZE=25


# ============================================================================
# Zoom joined with a BROWSER (zoom_web) — the connector that actually runs today
#
# Two legs, and they come from completely different places:
#   publish — Chromium joins app.zoom.us and the avatar speaks through a synthetic
#             microphone injected into the page
#   ingest  — RTMS, Zoom's own API. Audio, AND everything the avatar knows about
#             the meeting: who joined, who left, who is speaking, what each person
#             said, what they typed — each with a name attached.
#
# That last part is why this block is short where the Google Meet one is long.
# Meet has no participant API a guest can call, so that connector reads a DOM for
# all of it. Here the browser is asked for exactly ONE thing — a raised hand —
# because RTMS has no hand-raise event.
#
# Design: docs/design/008-zoom-web-meeting-awareness.md
# ============================================================================

MC_ZOOM_WEB__ENABLED=true

# THE ONE PIECE OF SETUP THIS CONNECTOR NEEDS. A persistent Chromium profile,
# signed in to Zoom, WITH A MICROPHONE ALREADY CHOSEN once interactively.
# Chromium stores the per-origin device choice in Default/Preferences; with a
# throwaway profile Zoom has no microphone selected, never starts its capture
# pipeline, and publishes NOTHING however good the injected track is — while every
# health check passes. Prepare it with: scripts/zoom_web_login.py
MC_ZOOM_WEB__PROFILE_DIR=~/.mc/zoom-web-profile

# false while tuning the hand-raise selectors, so you can watch the participants
# panel open. Set back to true for anything unattended.
MC_ZOOM_WEB__HEADLESS=false
#MC_ZOOM_WEB__NO_SANDBOX=false

# Only used when POST /sessions omits display_name; MC_ZOOM__DISPLAY_NAME above is
# the fallback the API actually applies. KEEP THEM IN STEP — this is the name that
# tells the avatar which participant is ITSELF, and five things key on it: whether
# it counts itself as an attendee, reports itself as the current speaker, feeds its
# own sentences back to the agent as a participant's, answers its own chat, and —
# worst — interrupts ITSELF, since it is an active speaker exactly when the
# barge-in gate is open. Both names are registered, so agreeing costs nothing.
MC_ZOOM_WEB__DISPLAY_NAME=AI Avatar

# ------------------------------------------------------ STOPPING THE ECHO LOOP
# HOW LONG INBOUND AUDIO IS WITHHELD AFTER THE AVATAR STOPS TALKING. Overrides the
# shared MC_MEDIA__ECHO_GATE_HANGOVER_MS (200ms) for this connector only.
#
# THE FAILURE THIS FIXES: RTMS delivers the meeting's mix INCLUDING THE AVATAR, so
# the avatar's own voice comes back — page -> Zoom encode -> Zoom mix -> RTMS -> us
# — about two seconds later. A mixed stream carries no per-frame name, so the
# name-based SelfAudioFilter cannot bite, leaving this gate as the only defence. At
# 200ms it reopens long before the TAIL of each sentence arrives, so the tail is
# forwarded, transcribed, and answered — by the avatar, to itself, in a loop.
#
# Seen with the human's microphone MUTED, so the only audio in the mix was the
# avatar's. Every "user" turn was the last word of the avatar's own sentence:
#     avatar: "...কোনো সাহায্য প্রয়োজন?"    ->  user: "প্রয়োজন।"
#     avatar: "...কীভাবে সাহায্য করতে পারি।"  ->  user: "পারি।"
#
# 200ms was right where it was chosen — for a connector whose barge-in works by
# HEARING the interruption, where a shut gate would drop it. This connector detects
# barge-in from Zoom's ACTIVE_SPEAKER_CHANGE event on the signaling socket instead,
# which arrives whether or not the gate is withholding audio. So the gate can be as
# conservative as the echo needs, and the gate is released the instant an interrupt
# is delivered — a barge-in never waits this out.
#
# Raise it if the agent still answers its own tail; lower it if the first word of a
# reply to the avatar gets clipped.
MC_ZOOM_WEB__ECHO_GATE_HANGOVER_MS=1500

# Ask RTMS for one MIXED stream rather than a stream per participant. Leave false.
# The avatar is IN the meeting, so multi-stream delivers at least two speakers as
# separate streams, which this pipeline drains into one sequential stream —
# splicing two people together and handing the transcriber audio chopped between
# them. Observed live: an English question came back as Indonesian fragments, with
# transcripts fourteen seconds behind.
#MC_ZOOM_WEB__PER_PARTICIPANT_AUDIO=false

# Generous, because it spans a waiting room: failing early turns a slow host into
# an error.
#MC_ZOOM_WEB__JOIN_TIMEOUT_S=90.0
#MC_ZOOM_WEB__JOIN_POLL_INTERVAL_S=2.0

# ------------------------------------------------------- RTMS subscriptions
# What the bridge asks Zoom to send. All three default true.
#
# TRANSCRIPT AND CHAT REQUIRE THEM TO BE ENABLED FOR THE APP ON THE ZOOM ACCOUNT.
# If they are not, Zoom REFUSES THE DATA HANDSHAKE — and a refused handshake ends
# the whole RTMS connection, i.e. the avatar goes deaf in a meeting it has already
# joined. So the bridge retries once with audio alone, switches the text features
# off, and puts the reason in the ingest component's health detail. Set these false
# to stop asking rather than living with the retry.
#MC_ZOOM_WEB__RTMS_TRANSCRIPT_ENABLED=true
#MC_ZOOM_WEB__RTMS_CHAT_ENABLED=true

# Participant join/leave and active-speaker events — the source of attendance, of
# who-is-speaking, AND of voice barge-in. Best-effort: some accounts deliver these
# unsolicited, so a rejected subscription never fails an attach.
#MC_ZOOM_WEB__RTMS_EVENTS_ENABLED=true

# ------------------------------------------------------------------- ledgers
# What the bridge REMEMBERS from those streams. Each costs nothing the meeting can
# hear — no scanning, no visible action, no extra traffic — which is why all three
# are on by default. Read them back with:
#   GET  /sessions/{id}/participants   who is here, who was, who never joined
#   GET  /sessions/{id}/speakers       who is talking, who has, for how long
#   GET  /sessions/{id}/transcript     what each person said, spoken and typed
#   POST /sessions/{id}/invitees       seed the invite list from the calendar
#MC_ZOOM_WEB__ATTENDANCE_ENABLED=true
#MC_ZOOM_WEB__SPEAKER_TRACKING_ENABLED=true
#MC_ZOOM_WEB__TRANSCRIPT_ENABLED=true

# Speech has gaps at every clause boundary. HOLD_MS keeps somebody as "the current
# speaker" across a pause — without it, asking who is talking between two sentences
# answers "nobody", and a barge-in landing in a gap is attributed to no one.
# MERGE_GAP_MS decides when a gap ENDS a turn rather than punctuating one: without
# it, two people alternating read as dozens of turns.
#MC_ZOOM_WEB__SPEAKER_HOLD_MS=1500
#MC_ZOOM_WEB__SPEAKER_MERGE_GAP_MS=1200

# ---------------------------------------------------------------------- chat
# Answer chat questions out loud. Unlike Google Meet this opens NO PANEL and
# scrapes nothing — Zoom delivers each message over RTMS with the sender's name.
#
# REQUIRES AN AGENT SPEAKING AVATAR PROTOCOL >= 1.1. An older agent negotiates 1.0,
# chat is withheld rather than sent, and the bridge logs avatar.chat_unsupported
# once. There is no override for this one — an agent cannot tell us it did not
# understand a frame, so it is not sent.
#MC_ZOOM_WEB__CHAT_ENABLED=true

# Answer only messages that @-TAG the avatar. Chat is a room of people talking to
# each other; a bot that replies to every line interrupts a room that was not
# talking to it. Zoom's chat box has an @ autocomplete, but what reaches RTMS is
# plain text with no participant token — so the @ is the only deliberate signal
# that survives the wire, and it is REQUIRED. Matched loosely (case and separators
# ignored, so @AI Avatar / @ai_avatar / @AIAvatar all count) but as whole words, so
# @Aisha does not trigger a bot named "AI". The mention is stripped before the text
# reaches the agent. Set false for a 1:1, where everything typed is for the avatar.
#MC_ZOOM_WEB__CHAT_REQUIRE_MENTION=true

# Extra names answered to after an @, on top of DISPLAY_NAME. Worth setting when
# the joined name is long and people will shorten it.
MC_ZOOM_WEB__CHAT_MENTION_NAMES=["bot","avatar"]

# ------------------------------------------------- what the agent is told, silently
# Who is here + who is talking + what was said, pushed to the agent as ONE
# meeting_context frame, on change only. One frame because AN AGENT HAS ONE SLOT
# for standing context — two pushers competing for it evict each other, and the
# observed symptom is an avatar that had been told the roster answering "Someone is
# present in the meeting".
#
# Never on the chat channel: a chat frame is a turn the avatar SAYS OUT LOUD, so
# pushing the roster down it would have the avatar announce arrivals into the room.
#MC_ZOOM_WEB__CONTEXT_PUSH_ENABLED=true

# Not how often anything is SENT — an unchanged meeting sends nothing at all. This
# is how often the ledgers are compared. Three seconds is the timescale a speaker
# changes on, which is the fastest thing in the brief.
#MC_ZOOM_WEB__CONTEXT_PUSH_INTERVAL_S=3.0

# SET FALSE TO SKIP THE AGENT'S HANDSHAKE CHANGE. Adding meeting context to an
# existing agent otherwise takes two edits — reply "1.2" in the server hello AND
# handle kind="meeting_context" — and forgetting the first silently disables the
# feature while the second looks done. Safe for any agent that IGNORES control
# frames it does not recognise, which is the usual behaviour. Leave it true if your
# agent instead raises on an unknown kind. It changes who is sent the frame, never
# the frame's kind.
MC_ZOOM_WEB__CONTEXT_PUSH_REQUIRE_NEGOTIATION=false

# ------------------------------------------------------ interrupting the avatar
# LET SOMEBODY TALKING OVER THE AVATAR STOP IT MID-SENTENCE. This is the fix for an
# avatar that speaks every reply to the end whatever anybody says.
#
# DRIVEN BY ZOOM'S ACTIVE-SPEAKER EVENT, NOT BY AUDIO ENERGY, and that is the one
# place this connector cannot copy the Google Meet one. RTMS delivers the meeting's
# mix INCLUDING THE AVATAR, so EchoGuard's speaking gate withholds every inbound
# frame while the avatar talks — an energy detector would be deaf during the only
# window a barge-in exists for. The event travels on the signaling socket, so it
# arrives regardless, and it names the person.
#
# Only fires WHILE THE AVATAR IS ACTUALLY SPEAKING. Somebody starting to talk into
# a silence is just the meeting happening, and interrupting nothing would send the
# agent "stop talking and let them speak" on every sentence anybody utters.
#
# Known cost: Zoom takes a moment to declare a new active speaker and the echo gate
# reopens a hangover later, so the first fraction of a second of the interrupting
# question does not reach the agent. The room hears the avatar stop; the agent
# hears the question from just after its start.
#MC_ZOOM_WEB__VOICE_INTERRUPT_ENABLED=true

# The same handover, triggered by a RAISED HAND. THE ONLY FEATURE HERE READ FROM
# THE BROWSER — RTMS has no hand-raise event, so the indicator exists only on
# screen. It therefore depends on selectors matching a UI Zoom is free to change,
# and it degrades to SILENCE, which is indistinguishable from nobody raising a
# hand. Watch for zoom_web.page_event in the log: handsArmed means the observer
# started, handsIdle means it ran and matched nothing.
#MC_ZOOM_WEB__HAND_RAISE_ENABLED=true

# THE MOST LIKELY REASON A CORRECT OBSERVER SEES NOTHING. With the participants
# panel closed Zoom renders a raised hand as a transient toast and, on some
# layouts, nothing at all. This clicks it open ONCE per session — the only visible
# action the avatar takes inside the meeting, which is why it is a switch.
MC_ZOOM_WEB__HAND_RAISE_OPEN_PANEL=true

# What the AGENT IS TOLD when somebody claims the floor — by hand OR by voice; one
# wording, two ways in. {name} is the person, or "Someone". Empty uses the wording
# that ships with the connector. This STEERS the reply; it is not the reply — the
# bridge contains no AI and speaks none of its own words.
#MC_ZOOM_WEB__HAND_RAISE_PROMPT={name} has a question. Stop talking and invite them to ask it.

# How long the same person is ignored after the avatar has yielded to them. Both
# inputs repeat — the page re-reads an unmoved hand, and Zoom re-reports the same
# active speaker through a conversation — and an avatar interrupted continuously
# never gets as far as saying "go ahead".
#MC_ZOOM_WEB__HAND_RAISE_COOLDOWN_S=10.0

# How long avatar audio keeps being discarded after an interrupt. THIS IS WHAT
# MAKES BARGE-IN AUDIBLE: when the floor is claimed the agent's speech is already
# in flight, so dropping only what is queued buys a couple of hundred milliseconds
# before the same sentence resumes. Raise it if the avatar audibly resumes; lower
# it if the "go ahead" starts mid-word.
#MC_ZOOM_WEB__HAND_RAISE_MUTE_MS=800

# ----- media pipeline (M4) -------------------------------------------------
MC_MEDIA__VIDEO_WIDTH=1280
MC_MEDIA__VIDEO_HEIGHT=720
MC_MEDIA__VIDEO_FPS=25
MC_MEDIA__PUBLISH_SAMPLE_RATE_HZ=32000
MC_MEDIA__INBOUND_QUEUE_SIZE=50
MC_MEDIA__VIDEO_QUEUE_SIZE=3
MC_MEDIA__AUDIO_QUEUE_SIZE=10

# ----- sidecar IPC (M5) ----------------------------------------------------
MC_SIDECAR__UDS_PATH=/tmp/mc-sidecar/sidecar.sock
MC_SIDECAR__CONNECT_TIMEOUT_S=15.0
MC_SIDECAR__HEARTBEAT_INTERVAL_S=2.0

# ============================================================================
# Microsoft Teams connector — all commented out, so this stays a Zoom-only
# deployment until someone opts in.
#
# The connector is registered ONLY when tenant_id, client_id, client_secret and
# sidecar_host are all present. Leaving them unset means the service carries no
# Teams surface at all, and `{"platform": "teams"}` returns a precise
# "no connector registered" instead of failing inside a join.
#
# Setup: src/connectors/teams/sidecar/dotnet/README.md
# Design: docs/design/005-teams-connector-architecture.md
# ============================================================================

# Azure AD app registration. Needs the APPLICATION permissions
# Calls.JoinGroupCall.All and Calls.AccessMedia.All, admin-consented — without
# the second one the bot joins successfully and no media ever flows.
#MC_TEAMS__TENANT_ID=
#MC_TEAMS__CLIENT_ID=
#MC_TEAMS__CLIENT_SECRET=

# The Windows host running mc-teams-sidecar. Teams' app-hosted media is
# Windows/.NET only, so this is a different machine — not a sibling process on a
# shared volume the way Zoom's C++ sidecar is.
#MC_TEAMS__SIDECAR_HOST=teams-bot.internal
#MC_TEAMS__SIDECAR_PORT=8445
#MC_TEAMS__SIDECAR_READY_TIMEOUT_S=60.0

# This link crosses a host boundary carrying meeting audio and a bearer token,
# so TLS is on by default. Point CA_FILE at the sidecar's issuer; add the client
# cert/key pair for mutual TLS on any shared network.
#MC_TEAMS__SIDECAR_TLS_ENABLED=true
#MC_TEAMS__SIDECAR_CA_FILE=/etc/mc/teams-sidecar-ca.pem
#MC_TEAMS__SIDECAR_CLIENT_CERT_FILE=
#MC_TEAMS__SIDECAR_CLIENT_KEY_FILE=

# Per-participant audio. Teams grants up to four dominant speakers with a source
# id, which is what lets EchoGuard filter by identity rather than relying on the
# speaking gate alone.
#MC_TEAMS__UNMIXED_AUDIO=true

# Teams' own media geometry, deliberately separate from MC_MEDIA__*: the two
# SDKs want different values and neither should have to move for the other.
# Teams negotiates video against an enumerated list — 1280x720@25 (this repo's
# shared default) is NOT one of them, which is why fps defaults to 30 here.
#MC_TEAMS__PUBLISH_SAMPLE_RATE_HZ=16000
#MC_TEAMS__VIDEO_WIDTH=1280
#MC_TEAMS__VIDEO_HEIGHT=720
#MC_TEAMS__VIDEO_FPS=30
#MC_TEAMS__DISPLAY_NAME=AI Avatar

# ============================================================================
# Google Meet connector
#
# Unlike Zoom and Teams there is NO app registration, client id, or secret —
# because Google publishes no server-side way to send media into a conference:
#
#   "All conference media streams are "receive-only". Currently, the Meet Media
#    API does not support sending of media from MediaApiClientInterface into a
#    conference."
#   -- developers.google.com/workspace/meet/media-api/reference/cpp/namespace/meet
#
# So the avatar joins as a real signed-in Chromium, and the "credential" is a
# browser profile on disk. Setup: setup-google-meet.txt
# Design:  docs/design/007-google-meet-connector-architecture.md
# ============================================================================

# The ONLY required value. Everything below has a working default.
# Holds the avatar's Google session; treated as a template, cloned per session.
# Sign it in once:  .venv/bin/python tools/meet_signin.py
# Gitignored via .meet/ — it contains a live session cookie.
MC_GOOGLE_MEET__PROFILE_DIR=.meet/profile

# MUST be true. Headed Chromium crashes its renderer on real Meet ("Aw, Snap!",
# error code 11 = SIGSEGV) on this machine, and it does so with ZERO injection and
# ZERO custom flags — proven by isolation: 6/6 headed trials crashed, 8/8 headless
# trials survived, including our full flag set. That is a Chromium/macOS fault, not
# ours. Headless carries media correctly and is verified against real Meet.
MC_GOOGLE_MEET__HEADLESS=true

# Only used if Meet asks for a name, which means the profile lost its Google
# session. A signed-in profile joins under its own account name.
MC_GOOGLE_MEET__DISPLAY_NAME=AI Avatar

# The synthetic camera's geometry. Separate from MC_MEDIA__* because each
# platform's runtime wants its own. Capped at 1080p: every frame crosses the
# page bridge as raw I420, and Meet downscales it anyway.
MC_GOOGLE_MEET__VIDEO_WIDTH=1280
MC_GOOGLE_MEET__VIDEO_HEIGHT=720
MC_GOOGLE_MEET__VIDEO_FPS=25

# Synthetic microphone rate. 48000 is Web Audio's native rate on desktop
# Chromium, so the track needs no resampling stage. Only 16000/24000/48000 are
# accepted — anything else Web Audio would resample *silently*, giving a pitch
# artefact with no error to trace.
MC_GOOGLE_MEET__PUBLISH_SAMPLE_RATE_HZ=48000

# Getting in. LOBBY is deliberately far longer than JOIN: "Asking to join" means
# a human has to notice a notification and click Admit, which is not a failure.
MC_GOOGLE_MEET__JOIN_TIMEOUT_S=120.0
MC_GOOGLE_MEET__LOBBY_TIMEOUT_S=300.0

# Recovery. Lower than the other connectors' 10 because a rejoin here relaunches
# a whole browser and may sit in a lobby again.
MC_GOOGLE_MEET__REJOIN_MAX_ATTEMPTS=5

# Catches the one failure every other health check reports as healthy: the
# browser alive and connected while conference audio has quietly stopped.
MC_GOOGLE_MEET__WATCHDOG_INTERVAL_S=5.0

# Forward the meeting's chat to the avatar as text, so a typed question gets a
# spoken answer. Requires an agent speaking avatar protocol >= 1.1; an older agent
# negotiates 1.0, chat is withheld rather than sent, and the bridge logs
# avatar.chat_unsupported once.
#
# Reading chat means OPENING THE CHAT PANEL — Meet renders message history nowhere
# else — which is a visible action by the avatar's own account. Set false for a
# meeting where the avatar should answer voice only.
#
# Only messages arriving after the avatar joins are forwarded; the backlog rendered
# when the panel opens is recorded and skipped.
MC_GOOGLE_MEET__CHAT_ENABLED=true

# Answer only the chat messages that @-TAG THE AVATAR, ignoring the rest of the
# conversation. Chat is a room of people talking to each other; an avatar that
# replies to every line interrupts a room that was not talking to it.
#
# Meet has no mention feature — no autocomplete, no participant token — so the @
# is the only deliberate signal a participant can give, and it is REQUIRED: it is
# what separates talking TO the avatar from talking ABOUT it. "@AI Avatar what is
# the CTC?" is answered; "did the AI avatar join?" is not.
#
# What follows the @ is matched loosely — case and separators are ignored, so
# "@AI Avatar", "@ai_avatar", "@ai-avatar" and "@AIAvatar" all count — but must
# stand as whole words, so "@Aisha" does not trigger a bot named "AI". The
# mention is stripped before the text reaches the agent.
#
# The name matched is the one Meet shows for the signed-in account, read from the
# roster — not DISPLAY_NAME, which Meet only asks for when the profile has lost
# its session. Set false to answer everything typed (fine for a 1:1 meeting).
MC_GOOGLE_MEET__CHAT_REQUIRE_MENTION=true

# Extra names the avatar answers to after an @, on top of the account's rendered
# name. Worth setting when that name is long and people will shorten it.
#MC_GOOGLE_MEET__CHAT_MENTION_NAMES=["Gunika","bot"]

# ---------------------------------------------------------------- raised hands
# Stop the avatar and hand over when somebody RAISES THEIR HAND in the meeting.
# The moment the hand goes up the avatar's audio is cut and the agent is told to
# yield, so the room hears it stop mid-sentence and say something like "of course,
# go ahead". It reacts whether or not it was speaking — waiting for a pause and
# then raising your hand still gets an answer.
#
# Unlike chat this opens no panel and changes nothing other participants see: the
# hand indicator is already on screen and the page only reads it. Set false for a
# meeting where the avatar should hold the floor (a presentation, a read-out).
#
# NO AGENT CHANGES NEEDED. The hand is delivered to the agent on the same frame a
# typed chat message uses — "Priya raised their hand and wants to say something" is
# just a line of text from a named participant — so any agent that already answers
# chat answers this. Cutting the avatar's audio happens here in the bridge, not at
# the agent, so it is immediate either way.
MC_GOOGLE_MEET__HAND_RAISE_ENABLED=true

# What the AGENT IS TOLD when a hand goes up; it composes the actual reply. {name}
# is the raiser, or "Someone" when Meet does not attribute the indicator. Empty
# uses the wording that ships with the connector, which asks it to stop and hand
# over in a few words. Change this to change the register, not the mechanism.
#MC_GOOGLE_MEET__HAND_RAISE_PROMPT={name} has a question. Stop talking and invite them to ask it.

# How long the same person's hand is ignored after the avatar has yielded to it.
# Meet's indicator re-renders constantly and an impatient person lowers and
# re-raises; either can produce a burst, and an avatar interrupted repeatedly
# never gets as far as saying "go ahead".
MC_GOOGLE_MEET__HAND_RAISE_COOLDOWN_S=10.0

# How long avatar audio keeps being discarded after an interrupt. THIS IS WHAT
# MAKES BARGE-IN AUDIBLE: when the hand goes up the agent's speech is already in
# flight, so dropping only what is queued buys a couple of hundred milliseconds
# before the same sentence resumes. Too short and it comes back; too long and the
# start of the agent's reply is clipped. Raise it if the avatar audibly resumes,
# lower it if the reply starts mid-word.
MC_GOOGLE_MEET__HAND_RAISE_MUTE_MS=800

# ------------------------------------------------------- interrupt by speaking
# SPEAKING IS TREATED EXACTLY LIKE RAISING YOUR HAND. Start talking while the
# avatar is answering and it runs the same handover HAND_RAISE_ENABLED runs: the
# queued speech is dropped AND the agent is sent HAND_RAISE_PROMPT, so it stops
# mid-sentence and says "ok, go ahead" before listening to your question.
#
# BOTH halves are needed and this is why it is not its own mechanism. Dropping the
# queued audio only disposes of speech that already exists — the agent keeps
# GENERATING the rest of its sentence and resumes the moment the hold lapses. Only
# telling the agent stops that, and a raised hand has always done both.
#
# It has NO SETTINGS OF ITS OWN beyond these two: the mute window is
# HAND_RAISE_MUTE_MS and the wording is HAND_RAISE_PROMPT. One handover, two ways
# in, nothing to drift apart.
MC_GOOGLE_MEET__SPEECH_INTERRUPT_ENABLED=false

# THE FLOOR UNDER THE SPEECH TRIGGER — not the trigger. The detector applies
#     max(this, learned_noise_floor * 3)
# where the noise floor is learned from the meeting while nobody is talking, so a
# quiet room gets a low bar and a loud one a high bar with nothing to tune. This
# only stops a near-silent meeting from setting a bar so low that line noise takes
# the floor.
#
# router.speech_detected logs rms / noise_floor / trigger_level on every trigger —
# tune against those numbers rather than guessing.
#
# NOTE: if you listen on SPEAKERS, your own echo canceller suppresses your voice
# while the avatar is talking (measured 20-100x quieter than speaking into
# silence), and no threshold here can recover audio that never arrived. Use a
# headset and this disappears.
MC_GOOGLE_MEET__SPEECH_INTERRUPT_THRESHOLD=500

# The loopback WebSocket the page connects back on. 0 = let the OS choose, which
# is what lets two concurrent sessions coexist.
MC_GOOGLE_MEET__BRIDGE_HOST=127.0.0.1
MC_GOOGLE_MEET__BRIDGE_PORT=0
MC_GOOGLE_MEET__BRIDGE_READY_TIMEOUT_S=60.0

# Extra Chromium flags, appended last so they override the built-ins. JSON list.
# Add --no-sandbox only where the container cannot be given SYS_ADMIN.
#MC_GOOGLE_MEET__EXTRA_BROWSER_ARGS=["--no-sandbox","--disable-setuid-sandbox"]

# Scripted sign-in. NOT recommended: it only bootstraps an empty profile, only
# works on an account with no 2FA, and repeatedly scripting Google's sign-in is
# what gets an automated account restricted. Use tools/meet_signin.py instead.
MC_GOOGLE_MEET__GOOGLE_EMAIL=jadumeetboot@gmail.com
MC_GOOGLE_MEET__GOOGLE_PASSWORD=devch@1234

# ----- Google Meet: browser-side diagnostics --------------------------------
# Both default to off. They exist because a renderer SIGSEGV on real Meet had to be
# isolated to a single injected stage, and they are what made that possible.

# Restrict which bridge.js bootstrap stages install. Empty/absent = all.
# Stages: devices, rtc, observers, heartbeat, socket, then capture, playout, canvas.
# Every stage reports begin/ok/threw, so the last one to complete is always in the log.
# Bisect a crash by walking the list:
#MC_GOOGLE_MEET__INJECT_STAGES=["devices"]
#MC_GOOGLE_MEET__INJECT_STAGES=["devices","rtc"]
#MC_GOOGLE_MEET__INJECT_STAGES=["devices","rtc","observers"]

# The all-or-nothing switch: launch and join, inject nothing. A session with this set
# CANNOT carry media and fails immediately with a message saying so — rather than
# waiting out bridge_ready_timeout_s and then burning the rejoin budget relaunching.
# Prefer INJECT_STAGES for bisecting; this proves whether injection is involved at all.
#MC_GOOGLE_MEET__DISABLE_INJECTION=true

MC_TEAMS_WEB__PROFILE_DIR=~/.mc/teams-web-profile
MC_TEAMS_WEB__ENABLED=true
MC_TEAMS_WEB__HEADLESS=false          # you need to see the DOM on the first run
MC_TEAMS_WEB__DISPLAY_NAME=AI Avatar
MC_TEAMS_WEB__CHAT_MENTION_NAMES=["bot","avatar"]
MC_TEAMS_WEB__CONTEXT_PUSH_REQUIRE_NEGOTIATION=false
# Only if you own the meeting — it is visible to everyone in the room:
MC_TEAMS_WEB__CAPTIONS_AUTO_ENABLE=true
# Do NOT set MC_TEAMS_WEB__ECHO_GATE_HANGOVER_MS — the gate is off here by design (doc 010 §4)
